# =====================================================================
# ORBITSTREAM RTL-SDR Collector Configuration
# Copy this file to .env and customize for your local station setup
# =====================================================================

# Remote Backend Deployment (Render or Local)
ORBITSTREAM_BACKEND_URL=https://orbitstream-hl80.onrender.com
# For local development against localhost backend:
# ORBITSTREAM_BACKEND_URL=http://127.0.0.1:8000

# Authenticated Revocable Collector Ingestion Secret Key
ORBITSTREAM_COLLECTOR_API_KEY=orbitstream-collector-key-2026

# Collector Operating Mode:
# 'hardware' = Read physical I/Q samples from connected RTL-SDR USB dongle (Default)
# 'demo'     = Generate synthetic demonstration samples (for testing without SDR hardware)
SDR_MODE=hardware

# Target Center Frequency in Hz (e.g. 100 MHz FM broadcast, or satellite downlink e.g. 137.5 MHz for NOAA APT)
SDR_FREQUENCY_HZ=100000000

# SDR Sampling Rate in Hz (Default 1.024 MS/s; Max recommended for RTL2832U is 2.4 MS/s)
SDR_SAMPLE_RATE_HZ=1024000

# Tuner Gain ('auto' or numeric value in dB, e.g. 29.7)
SDR_GAIN=auto

# Telemetry Collection Interval in Seconds (Default: 10)
SDR_INTERVAL_SECONDS=10

# Complex Samples Per Measurement (2^18 = 262144 samples)
SDR_SAMPLE_COUNT=262144

# Device Identification
SDR_DEVICE_INDEX=0
SDR_DEVICE_ID=rtlsdr-station-win01

# Downsampled FFT Spectrum Bins for Telemetry Summary (default: 64)
SDR_SPECTRUM_BINS=64

